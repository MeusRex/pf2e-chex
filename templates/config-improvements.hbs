<section class="tab {{tab.cssClass}}" data-tab="improvements" data-group="primary">
    <p class="hint">{{localize "CHEX.CONFIG.ImprovementsHint"}}</p>
    <table class="chex-config-table">
        <thead>
            <tr>
                <th></th>
                <th>{{localize "CHEX.Id"}}</th>
                <th>{{localize "CHEX.Label"}}</th>
                <th data-tooltip="CHEX.CONFIG.Field.extractsTT">{{localize "CHEX.CONFIG.Field.extracts"}}</th>
                <th data-tooltip="CHEX.CONFIG.Field.yieldTT">{{localize "CHEX.CONFIG.Field.yield"}}</th>
                <th data-tooltip="CHEX.CONFIG.Field.travelTT">{{localize "CHEX.CONFIG.Field.travel"}}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {{#each improvementRows as |m i|}}
            <tr>
                <td>
                    <img class="chex-config-img" src="{{m.img}}" data-action="pickImage" data-path="improvements.{{i}}.img" data-tooltip="CHEX.PickImage">
                    <input type="hidden" name="improvements.{{i}}.img" value="{{m.img}}">
                </td>
                <td><input type="text" name="improvements.{{i}}.id" value="{{m.id}}" data-tooltip="CHEX.IdTT"></td>
                <td><input type="text" name="improvements.{{i}}.label" value="{{m.label}}"></td>
                <td class="chex-extraction-cell">
                    <input type="hidden" name="improvements.{{i}}.extracts" value="{{m.extracts}}">
                    <input type="hidden" name="improvements.{{i}}.allowed" value="{{m.extraction.allowedText}}">
                    <a class="chex-extraction-summary" data-action="editExtraction" data-index="{{i}}" data-tooltip="CHEX.CONFIG.EditExtraction">
                        <i class="fa-solid fa-pen-to-square"></i>
                        {{#if m.extraction.category}}<span>{{m.extraction.category}}{{#if m.extraction.all}}: {{localize "CHEX.CONFIG.All"}}{{/if}}</span>{{/if}}
                        {{#each m.extraction.resources}}<img src="{{this.img}}" data-tooltip="{{this.label}}">{{/each}}
                        {{#unless (or m.extraction.category m.extraction.resources.length)}}<span class="chex-muted">{{localize "CHEX.ECONOMY.Nothing"}}</span>{{/unless}}
                    </a>
                </td>
                <td><input type="number" name="improvements.{{i}}.yield" value="{{m.yield}}" min="0" step="1"></td>
                <td><input type="number" name="improvements.{{i}}.travel" value="{{m.travel}}" step="1"></td>
                <td><a class="chex-row-control" data-action="deleteRow" data-category="improvements" data-index="{{i}}" data-tooltip="CHEX.Delete"><i class="fa-solid fa-trash"></i></a></td>
            </tr>
            {{/each}}
        </tbody>
    </table>
    <button type="button" data-action="addRow" data-category="improvements"><i class="fa-solid fa-plus"></i> {{localize "CHEX.Add"}}</button>
</section>
