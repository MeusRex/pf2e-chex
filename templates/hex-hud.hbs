<div class="chex-hud-content">
    <header class="chex-hud-header">
        <img class="chex-hud-terrain" src="{{terrain.img}}">
        <div class="chex-hud-title">
            <strong>{{name}}</strong>
            <span>{{terrain.label}}</span>
        </div>
    </header>

    <div class="chex-hud-group">
        <p><span class="chex-muted">{{localize "CHEX.HUD.Travel"}}</span><span>{{travel.label}} · ×{{travel.multiplier}}</span></p>
        {{#if exploration}}<p><span class="chex-muted">{{localize "CHEX.HUD.Explored"}}</span><span>{{localize exploration}}</span></p>{{/if}}
        {{#if cleared}}<p><span class="chex-muted">{{localize "CHEX.HUD.Cleared"}}</span><i class="fa-solid fa-check"></i></p>{{/if}}
        {{#if claim}}<p><span class="chex-muted">{{localize "CHEX.HUD.Claimed"}}</span><span style="color: {{claim.color}};"><i class="{{icons.realm}}"></i> {{claim.label}}</span></p>{{/if}}
        {{#if settlement}}<p><span class="chex-muted">{{settlement.size}}</span><span style="color: {{settlement.color}};"><i class="{{icons.settlement}}"></i> {{settlement.name}}</span></p>{{/if}}
    </div>

    {{#if improvements.length}}
    <div class="chex-hud-group">
        {{#each improvements}}
        <p><img src="{{this.img}}"><span class="chex-grow">{{this.label}}</span><span class="chex-muted">{{this.effect}}</span>{{#if ../isGM}}<i class="fa-solid {{this.eye}}"></i>{{/if}}</p>
        {{/each}}
    </div>
    {{/if}}

    {{#if resources.length}}
    <div class="chex-hud-group">
        {{#each resources}}
        <p><img src="{{this.img}}"><span class="chex-grow">{{this.label}}</span><span>×{{this.amount}}</span>{{#if ../isGM}}<i class="fa-solid {{this.eye}}"></i>{{/if}}</p>
        {{/each}}
    </div>
    {{/if}}

    {{#if forageables.length}}
    <div class="chex-hud-group">
        {{#each forageables}}
        <p><img src="{{this.img}}"><span class="chex-grow">{{this.label}}</span><span><i class="fa-solid fa-gift"></i> {{this.amount}}</span>{{#if ../isGM}}<i class="fa-solid {{this.eye}}"></i>{{/if}}</p>
        {{/each}}
    </div>
    {{/if}}

    {{#if features.length}}
    <div class="chex-hud-group">
        {{#each features}}
        <p><img src="{{this.img}}"><span class="chex-grow">{{this.label}}</span><span>{{this.name}}</span>{{#if ../isGM}}<i class="fa-solid {{this.eye}}"></i>{{/if}}</p>
        {{/each}}
    </div>
    {{/if}}
</div>
