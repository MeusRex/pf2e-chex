<div class="chex-hud-content">
    <header class="chex-hud-header">
        <img class="chex-hud-terrain" src="{{terrain.img}}">
        <div class="chex-hud-title">
            <strong>{{name}}</strong>
            <span>{{terrain.label}}</span>
        </div>
        {{#if claim}}
        <img class="chex-heraldry chex-hud-heraldry" src="{{claim.img}}" style="--item-color: {{claim.color}}" alt="{{claim.label}}">
        {{/if}}
    </header>

    <div class="chex-hud-group chex-hud-info">
        <span class="chex-muted">{{localize "CHEX.HUD.Travel"}}</span><span>{{travel.label}} · ×{{travel.multiplier}}</span>
        {{#if exploration}}<span class="chex-muted">{{localize "CHEX.HUD.Explored"}}</span><span>{{localize exploration}}</span>{{/if}}
        {{#if cleared}}<span class="chex-muted">{{localize "CHEX.HUD.Cleared"}}</span><span><i class="fa-solid fa-check"></i></span>{{/if}}
        {{#if claim}}<span class="chex-muted">{{localize "CHEX.HUD.Claimed"}}</span><span style="color: {{claim.color}};">{{claim.label}}</span>{{/if}}
        {{#if settlement}}<span class="chex-muted">{{settlement.size}}</span><span style="color: {{settlement.color}};"><i class="{{icons.settlement}}"></i> {{settlement.name}}</span>{{/if}}
    </div>

    {{!-- lists: icon | label | value | visibility (GM). One grid per list, so labels line up --}}
    {{#if improvements.length}}
    <div class="chex-hud-group chex-hud-list {{#if isGM}}gm{{/if}}">
        {{#each improvements}}
        <img src="{{this.img}}"><span>{{this.label}}</span><span class="chex-muted">{{this.effect}}</span>{{#if ../isGM}}<i class="fa-solid {{this.eye}}"></i>{{/if}}
        {{/each}}
    </div>
    {{/if}}

    {{#if resources.length}}
    <div class="chex-hud-group chex-hud-list {{#if isGM}}gm{{/if}}">
        {{#each resources}}
        <img src="{{this.img}}"><span>{{this.label}}</span><span>×{{this.amount}}</span>{{#if ../isGM}}<i class="fa-solid {{this.eye}}"></i>{{/if}}
        {{/each}}
    </div>
    {{/if}}

    {{#if forageables.length}}
    <div class="chex-hud-group chex-hud-list {{#if isGM}}gm{{/if}}">
        {{#each forageables}}
        <img src="{{this.img}}"><span>{{this.label}}</span><span><i class="fa-solid fa-gift"></i> {{this.amount}}</span>{{#if ../isGM}}<i class="fa-solid {{this.eye}}"></i>{{/if}}
        {{/each}}
    </div>
    {{/if}}

    {{#if features.length}}
    <div class="chex-hud-group chex-hud-list {{#if isGM}}gm{{/if}}">
        {{#each features}}
        <img src="{{this.img}}"><span>{{this.label}}</span><span>{{this.name}}</span>{{#if ../isGM}}<i class="fa-solid {{this.eye}}"></i>{{/if}}
        {{/each}}
    </div>
    {{/if}}
</div>
