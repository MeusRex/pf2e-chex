<form class="flexcol" autocomplete="off">
    <fieldset>
        <legend>{{localize 'CHEX.HEXEDIT.Exploration'}}</legend>
        <div class="form-group">
            <label data-tooltip="CHEX.HEXEDIT.ExplorationTooltip">{{localize 'CHEX.HEXEDIT.Exploration'}}</label>
            <div class="form-fields">
                <select name="exploration">
                    {{selectOptions explorationStates selected=hex.exploration valueAttr="value" labelAttr="label" localize=true }}
                </select>
            </div>
        </div>

        <div class="form-group">
            <label data-tooltip="CHEX.HEXEDIT.ClearedTooltip">{{localize 'CHEX.HEXEDIT.Cleared'}}</label>
            <input type="checkbox" name="cleared" {{checked hex.cleared}}>
        </div>

        <div class="form-group">
            <label data-tooltip="CHEX.HEXEDIT.ClaimedTooltip">{{localize 'CHEX.HEXEDIT.Claimed'}}</label>
            <div class="form-fields">
                <select name="claimed">
                    {{selectOptions claimees selected=hex.claimed valueAttr="id" labelAttr="label" blank=""}}
                </select>
            </div>
        </div>
    </fieldset>

    <fieldset>
        <legend>{{localize 'CHEX.ECONOMY.Settlement.Title'}}</legend>
        {{#if settlement}}
        <div class="form-group">
            <label>{{settlement.name}} <span class="chex-muted">({{settlement.sizeLabel}}, {{settlement.realmLabel}})</span></label>
            <div class="form-fields">
                <button type="button" data-action="openSettlement"><i class="fa-solid fa-city"></i> {{localize 'CHEX.ECONOMY.Settlement.Open'}}</button>
                <button type="button" data-action="unplaceSettlement" data-tooltip="CHEX.ECONOMY.Settlement.Unplace"><i class="fa-solid fa-location-pin-lock"></i></button>
            </div>
        </div>
        {{else if canFound}}
        <div class="form-group">
            <button type="button" data-action="foundSettlement"><i class="fa-solid fa-flag"></i> {{localize 'CHEX.ECONOMY.Settlement.Found'}}</button>
        </div>
        {{#if unplaced.length}}
        <div class="form-group">
            <select class="chex-unplaced-settlement">
                {{selectOptions unplaced valueAttr="id" labelAttr="name"}}
            </select>
            <button type="button" data-action="placeSettlement"><i class="fa-solid fa-location-dot"></i> {{localize 'CHEX.ECONOMY.Settlement.PlaceHere'}}</button>
        </div>
        {{/if}}
        <p class="hint">{{localize 'CHEX.ECONOMY.Settlement.ImmediateHint'}}</p>
        {{else}}
        <p class="hint">{{localize 'CHEX.ECONOMY.Settlement.ClaimFirst'}}</p>
        {{/if}}
    </fieldset>

    <fieldset>
        <legend>
            {{localize 'CHEX.HEXEDIT.Improvements'}}
            <button type="button" data-action="addImprovement" class="chex-add-button">
                <span>{{localize 'CHEX.HEXEDIT.Add'}}</span>
            </button>
        </legend>
        {{#each hex.improvements as |item i|}}
            {{> (lookup @root "improvementsFrag") id=i key=item.id resource=item.resource show=item.show improvements=@root.improvements extractables=@root.extractables}}
        {{/each}}
    </fieldset>

    <fieldset>
        <legend>
            {{localize 'CHEX.HEXEDIT.Features'}}
            <button type="button" data-action="addFeature" class="chex-add-button">
                <span>{{localize 'CHEX.HEXEDIT.Add'}}</span>
            </button>
        </legend>
        {{#each hex.features as |item2 i2|}}
            {{> (lookup @root "featuresFrag") id=i2 key=item2.id name=item2.name show=item2.show features=@root.features}}
        {{/each}}
    </fieldset>

    <fieldset>
        <legend>
            {{localize 'CHEX.HEXEDIT.Resources'}}
            <button type="button" data-action="addResource" class="chex-add-button">
                <span>{{localize 'CHEX.HEXEDIT.Add'}}</span>
            </button>
        </legend>
        {{#each hex.resources as |item3 i3|}}
            {{> (lookup @root "resourcesFrag") id=i3 key=item3.id amount=item3.amount show=item3.show resources=@root.resources}}
        {{/each}}
    </fieldset>

    <fieldset>
        <legend>
            {{localize 'CHEX.HEXEDIT.Forageables'}}
            <button type="button" data-action="addForageable" class="chex-add-button">
                <span>{{localize 'CHEX.HEXEDIT.Add'}}</span>
            </button>
        </legend>
        {{#each hex.forageables as |item4 i4|}}
            {{> (lookup @root "forageablesFrag") id=i4 key=item4.id amount=item4.amount show=item4.show forageables=@root.resources}}
        {{/each}}
    </fieldset>

    <footer>
        <button type="submit">
            <i class="fa-solid fa-save"></i>
            <span>{{localize 'CHEX.HEXEDIT.Save'}}</span>
        </button>
    </footer>
</form>