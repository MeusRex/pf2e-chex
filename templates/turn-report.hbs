<div class="chex-app chex-turn-report">
    <h3 style="border-left: 4px solid {{realm.color}}; padding-left: 4px;">
        {{realm.label}} — {{localize "CHEX.ECONOMY.Kingdom.Turn"}} {{turn}}
    </h3>
    <p><i class="fa-solid fa-face-smile"></i> {{localize "CHEX.ECONOMY.Happiness"}}: <strong>{{happiness}}%</strong></p>

    {{#if settlements.length}}
    <ul>
        {{#each settlements}}
        <li>
            {{this.name}}: {{this.happiness}}%
            {{#each this.unmet}}<br><span class="chex-bad">− {{this.missing}} {{this.label}}</span>{{/each}}
        </li>
        {{/each}}
    </ul>
    {{/if}}

    {{#if idle.length}}
    <p><strong>{{localize "CHEX.ECONOMY.Report.Idle"}}</strong></p>
    <ul>{{#each idle}}<li>{{this.building}} ({{this.settlement}})</li>{{/each}}</ul>
    {{/if}}

    {{#if unpaid.length}}
    <p><strong>{{localize "CHEX.ECONOMY.Report.Unpaid"}}</strong></p>
    <ul>{{#each unpaid}}<li>{{this}}</li>{{/each}}</ul>
    {{/if}}

    <p><strong>{{localize "CHEX.ECONOMY.Kingdom.Produced"}}</strong></p>
    {{> "modules/pf2e-chex/templates/amounts-inline.hbs" amounts=produced sign="+"}}
    <p><strong>{{localize "CHEX.ECONOMY.Report.NetChange"}}</strong></p>
    {{> "modules/pf2e-chex/templates/amounts-inline.hbs" amounts=net}}
</div>
