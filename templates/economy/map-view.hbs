<div class="chex-map-view-content">
    <button type="button" class="chex-map-option {{#if settlements}}active{{/if}}" data-action="toggleSettlements">
        <i class="fa-solid fa-city"></i>
        <span>{{localize "CHEX.MAPVIEW.Settlements"}}</span>
        <i class="fa-solid {{#if settlements}}fa-toggle-on{{else}}fa-toggle-off{{/if}} chex-map-option-state"></i>
    </button>

    <h4>{{localize "CHEX.MAPVIEW.HexDetails"}}</h4>
    {{#each details}}
    <button type="button" class="chex-map-option {{#if this.active}}active{{/if}}" data-action="setDetails" data-details="{{this.id}}">
        <i class="{{this.icon}}"></i>
        <span>{{localize this.label}}</span>
        {{#if this.active}}<i class="fa-solid fa-check chex-map-option-state"></i>{{/if}}
    </button>
    {{/each}}

    {{#if overlayOff}}
    <p class="hint"><i class="fa-solid fa-circle-info"></i> {{localize "CHEX.MAPVIEW.OverlayOff"}}</p>
    {{/if}}
</div>
