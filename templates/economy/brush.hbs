<div class="chex-brush-content">
    <div class="chex-presets">
        {{#each modes}}
        <button type="button" class="{{#if this.active}}active{{/if}}" data-action="setMode" data-mode="{{this.id}}">
            <i class="{{this.icon}}"></i> {{localize this.label}}
        </button>
        {{/each}}
    </div>

    <div class="chex-brush-grid">
        {{#each items}}
        <a class="chex-brush-item {{#if this.active}}active{{/if}}" data-action="select" data-id="{{this.id}}" data-tooltip="{{this.label}}">
            <img src="{{this.img}}" alt="{{this.label}}">
        </a>
        {{/each}}
    </div>

    <div class="chex-brush-options">
        {{#if isImprovements}}
        {{#if extracting}}
        <label data-tooltip="CHEX.HEXEDIT.ExtractedTooltip">
            <span>{{localize "CHEX.BRUSH.Extracts"}}</span>
            <select name="extracted">
                {{selectOptions candidates selected=extracted valueAttr="id" labelAttr="label" blank=(localize "CHEX.HEXEDIT.ExtractedAuto")}}
            </select>
        </label>
        {{/if}}
        {{else}}
        <label>
            <span>{{localize "CHEX.HEXEDIT.Amount"}}</span>
            <input type="number" name="amount" value="{{amount}}" min="1" step="1">
        </label>
        {{/if}}
        <label data-tooltip="CHEX.HEXEDIT.ShowToPlayersTooltip">
            <span>{{localize "CHEX.BRUSH.Visible"}}</span>
            <input type="checkbox" name="show" {{checked show}}>
        </label>
    </div>

    <p class="hint">{{localize "CHEX.BRUSH.Hint"}}</p>
</div>
